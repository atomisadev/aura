BACKEND_ORIGIN=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_BASE_PATH=/api/auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
DATABASE_URL=postgres://user:password@your-neon-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgres://user:password@your-neon-endpoint.region.aws.neon.tech/neondb?sslmode=require
GITHUB_CLIENT_ID=replace-with-your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-app-client-secret
S3_BUCKET=replace-with-your-bucket-name
S3_REGION=auto
S3_ENDPOINT=https://replace-with-your-s3-or-r2-endpoint
S3_ACCESS_KEY_ID=replace-with-your-access-key
S3_SECRET_ACCESS_KEY=replace-with-your-secret-key
S3_PUBLIC_BASE_URL=https://replace-with-your-public-bucket-host
S3_FORCE_PATH_STYLE=false
MAX_AUDIO_UPLOAD_BYTES=104857600
